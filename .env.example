# ---------------------------------------------------------------------------
# BONFILS STORE - environment configuration
# Copy to `.env` for local development (`.env.local` is read first) and set the
# same values in the Vercel project settings for production.
# Never commit real secrets: `.env` and `.env.local` are git-ignored.
# ---------------------------------------------------------------------------

# Public URL of the deployment (no trailing slash), e.g. https://bonfilsstore.com
APP_URL="http://localhost:3000"

# Database -------------------------------------------------------------------
# Neon/Vercel Postgres pooled connection string. Required in production: the
# JSON/memory fallback is only for local development and loses data on restart.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Legacy aliases still supported: POSTGRES_URL, PG_URL, POSTGRES_PRISMA_URL
# Create tables on boot (idempotent). Set to false once migrations are managed
# outside the app.
RUN_MIGRATIONS_ON_BOOT="true"

# Email delivery (SMTP, checked first; Resend is the fallback) -----------------
# OTP codes, order confirmations, quotations and shipping updates all go through
# whichever transport is configured. EMAIL_HOST + EMAIL_USER + EMAIL_PASS turn on
# SMTP; if they are absent the app falls back to RESEND_API_KEY. With neither, mail
# is still recorded in the admin console but never delivered.
#
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords. Use that 16-character code as
# EMAIL_PASS - never your normal account password. Gmail only accepts mail From:
# the authenticated mailbox unless you set EMAIL_FROM to a verified alias.
#
# Port 465 = implicit TLS (EMAIL_SECURE defaults to true).
# Port 587 = STARTTLS, so set EMAIL_SECURE="false" and the client still refuses
# to fall back to plaintext.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="your.address@gmail.com"
EMAIL_PASS="your_16_character_google_app_password"
# Display name shown in the recipient's inbox and used in the HTML header.
EMAIL_FROM_NAME="BonfilsStore"
# Only set this to a Gmail-verified alias. Left unset, SMTP sends from EMAIL_USER.
# EMAIL_FROM="BONFILS STORE <notifications@bonfilsstore.com>"

# Fallback transactional provider. Ignored while EMAIL_USER/EMAIL_PASS are set.
RESEND_API_KEY=""

# Uploads ---------------------------------------------------------------------
# Vercel Blob token. Without it, uploaded images are stored in the database as
# data URLs, which is fine for testing but not for a real catalogue.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token"

# Super Admin bootstrap ------------------------------------------------------
# Used once by `npm run superadmin:create` (or automatically on first boot
# when both values are present) to create/promote the first administrator.
# Minimum 12 characters. Remove SUPER_ADMIN_PASSWORD after bootstrapping.
SUPER_ADMIN_EMAIL="admin@bonfilsstore.com"
SUPER_ADMIN_PASSWORD="change_me_to_a_long_random_password"
SUPER_ADMIN_NAME="BONFILS Super Admin"

# Seed data ------------------------------------------------------------------
# Set to false in production if you do not want the demo customer/seller
# accounts created by `npm run seed`.
SEED_DEMO_ACCOUNTS="true"

# Sessions / OTPs ------------------------------------------------------------
# Signing secret for hashed verification codes and session tokens.
OTP_SECRET="replace_with_a_long_random_string"

# Supabase (optional, browser) -------------------------------------------------
# Read by `src/services/supabaseClient.ts`.
#
# VITE_ variables are INLINED INTO THE PUBLIC JS BUNDLE at build time, so:
#   * only ever put the anon / publishable key here, never the service-role key
#     (it bypasses Row Level Security). The client throws on startup if it
#     detects one, because by then the key is already in the built JavaScript.
#   * set these in Vercel as Build-time AND Runtime variables, then redeploy -
#     changing them does not affect an already-built bundle.
#
# The app currently runs entirely on the server API (`/api/*` -> Express ->
# Postgres). Nothing imports this client yet, so it is tree-shaken out of the
# bundle. If you wire it up, every table it can reach needs Row Level Security
# configured first; otherwise the anon key grants unauthenticated read/write and
# the server-side checks in `server/middleware.ts` stop being the only thing
# between a visitor and the database.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Runtime --------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
